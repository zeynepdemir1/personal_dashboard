# Google Calendar salt-okunur senkronizasyonu için gizli iCal adresi.
# Google Calendar > Ayarlar (dişli ikonu) > senkronize etmek istediğin
# takvim > "Takvimi entegre et" > "iCal formatındaki gizli adres".
#
# ÖNEMLİ: Bu adres bir sırdır — sahibi olan herkes takvimini salt-okunur
# görebilir. Bu dosyayı .env.local olarak kopyala (o dosya .gitignore'da,
# asla commit edilmez); bu .env.example dosyasının kendisi boş kaldığı
# için güvenle commit edilebilir.
#
# GCAL_ICS_URL değişkeninin başında VITE_ ÖNEKİ YOK — bu bilinçli bir
# tercih: VITE_ ile başlayan değişkenler Vite tarafından tarayıcıya
# gönderilen koda gömülür (herkese açık hale gelir). Bu adres sadece
# vite.config.ts içindeki geliştirme sunucusu proxy'sinde, Node
# tarafında kullanılıyor ve tarayıcıya hiç ulaşmıyor.
GCAL_ICS_URL=

# Günlük Telegram bildirimi (PLAN.md Aşama 15, madde 5) için.
# TELEGRAM_BOT_TOKEN: @BotFather'da /newbot ile oluşturulan bot token'ı.
# TELEGRAM_CHAT_ID: bildirimin gideceği sohbetin kimliği (@userinfobot ile
#   veya https://api.telegram.org/bot<TOKEN>/getUpdates ile bulunur).
# CRON_SECRET: server.js'teki /api/notify/daily uç noktasını dışarıdan
#   (GitHub Actions) tetiklerken kullanılan paylaşılan sır — bu olmadan
#   uç nokta isteği reddeder. GitHub repo secrets'a da aynısı eklenmeli
#   (bkz. .github/workflows/daily-telegram-notify.yml).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRON_SECRET=

# Fotoğraf depolama (PLAN.md Aşama 16) — Merak Konuları/Proje Fikirleri
# fotoğrafları artık localStorage'a base64 olarak değil, Cloudinary'nin
# ücretsiz katmanına yükleniyor; localStorage'da sadece dönen URL duruyor.
# Cloudinary hesabı > Dashboard'da bu üç değer görünür. API_SECRET asla
# istemciye gönderilmez, sadece server.js'te (sunucu taraflı) kullanılır.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Program Keşfi / otomatik arama (PLAN.md Aşama 11) için SerpApi anahtarı.
# https://serpapi.com/manage-api-key — kart istemeden kayıt, ayda otomatik
# yenilenen 250 ücretsiz sorgu. (Not: Brave Search API yerine bu tercih
# edildi — Brave Şubat 2026'dan itibaren yeni kayıtlarda kart istiyor ve
# kredi bitince otomatik ücretlendirmeye geçiyor.)
SERPAPI_KEY=

# Program Keşfi'nin kalıcı deposu: Upstash Redis (ücretsiz katman, kart
# istemez). upstash.com > veritabanı oluştur > Dashboard'da "REST API"
# bölümünden bu iki değer alınır. Tarama sonuçları (görülen id'ler +
# başlık/link/özet kayıtları) burada tutulur, taramalar arasında kalıcı
# olması gerektiği için (Render'ın disk'i kalıcı değil, bkz. Aşama 16).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
